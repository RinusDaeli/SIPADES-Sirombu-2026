<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct API Rewrites to cPanel PHP Bridge
  RewriteRule ^api/cpanel/test/?$ cpanel-api.php?action=ping [QSA,L]
  RewriteRule ^api/cpanel/upload/?$ cpanel-api.php?action=upload_all [QSA,L]
  RewriteRule ^api/cpanel/save_aset/?$ cpanel-api.php?action=save_aset [QSA,L]
  RewriteRule ^api/cpanel/delete_aset/?$ cpanel-api.php?action=delete_aset [QSA,L]
  RewriteRule ^api/zip-base64/?$ cpanel-api.php?action=zip_base64 [QSA,L]
  RewriteRule ^api/download-zip/?$ sipades-web-sirombu.zip [L]
  RewriteRule ^api/data/?$ cpanel-api.php?action=data [QSA,L]
  RewriteRule ^api/asets/batch/?$ cpanel-api.php?action=upload_all [QSA,L]
  RewriteRule ^api/asets/?$ cpanel-api.php?action=save_aset [QSA,L]
  RewriteRule ^api/asets/(.*)$ cpanel-api.php?action=save_aset&id=$1 [QSA,L]
  RewriteRule ^api/events/?$ cpanel-api.php?action=ping [QSA,L]

  # 2. Serve existing files and uploads directly
  RewriteCond %{REQUEST_URI} ^/uploads/ [OR]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Fallback for React Router / Single Page App navigation
  RewriteRule ^ index.html [L]
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>
