{
  "entities": {
    "Aset": {
      "title": "Aset",
      "description": "Data Barang Milik Desa / Aset Desa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "desaId": { "type": "string" },
        "desaName": { "type": "string" },
        "klasifikasi": { "type": "string" },
        "namaAset": { "type": "string" },
        "kodeAset": { "type": "string" },
        "bukti": { "type": "object" },
        "tahunPerolehan": { "type": "number" },
        "nilaiPerolehan": { "type": "number" },
        "kondisi": { "type": "string" },
        "sumberDana": { "type": "string" },
        "volume": { "type": "string" },
        "lokasi": { "type": "string" },
        "keterangan": { "type": "string" },
        "fotoAset": { "type": "array" },
        "fotoBast": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "desaId", "desaName", "klasifikasi", "namaAset", "kodeAset", "tahunPerolehan", "nilaiPerolehan", "kondisi", "sumberDana", "status"]
    },
    "PermohonanVerifikasi": {
      "title": "PermohonanVerifikasi",
      "description": "Pengajuan mutasi atau penghapusan aset ke Kecamatan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "asetId": { "type": "string" },
        "desaId": { "type": "string" },
        "desaName": { "type": "string" },
        "tipe": { "type": "string" },
        "asetSnapshot": { "type": "object" },
        "tanggalPengajuan": { "type": "string" },
        "alasan": { "type": "string" },
        "nomorSuratDesa": { "type": "string" },
        "dokumenPendukung": { "type": "string" },
        "tujuanMutasi": { "type": "string" },
        "status": { "type": "string" },
        "tanggalDiproses": { "type": "string" },
        "diverifikasiOleh": { "type": "string" },
        "catatanKecamatan": { "type": "string" },
        "nomorSKKecamatan": { "type": "string" }
      },
      "required": ["id", "asetId", "desaId", "desaName", "tipe", "tanggalPengajuan", "alasan", "nomorSuratDesa", "status"]
    },
    "PengesahanLaporan": {
      "title": "PengesahanLaporan",
      "description": "Status pengesahan laporan aset tahunan per desa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "desaId": { "type": "string" },
        "desaName": { "type": "string" },
        "tahun": { "type": "number" },
        "status": { "type": "string" },
        "catatanKecamatan": { "type": "string" },
        "diajukanPada": { "type": "string" },
        "disetujuiPada": { "type": "string" },
        "disetujuiOleh": { "type": "string" }
      },
      "required": ["id", "desaId", "desaName", "tahun", "status"]
    },
    "Desa": {
      "title": "Desa",
      "description": "Profil 25 Desa di Kecamatan Sirombu",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "kepalaDesa": { "type": "string" },
        "nipKepalaDesa": { "type": "string" },
        "alamatDesa": { "type": "string" },
        "emailDesa": { "type": "string" },
        "nomorHp": { "type": "string" },
        "kodePos": { "type": "string" },
        "kaurAset": { "type": "string" },
        "sekdes": { "type": "string" },
        "kontak": { "type": "string" }
      },
      "required": ["id", "name", "code", "kepalaDesa"]
    },
    "User": {
      "title": "User",
      "description": "Akun pengguna aplikasi SIPADES",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "desaId": { "type": "string" },
        "desaName": { "type": "string" },
        "nip": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "KecamatanProfile": {
      "title": "KecamatanProfile",
      "description": "Profil dan penandatangan Kecamatan Sirombu",
      "type": "object",
      "properties": {
        "namaKecamatan": { "type": "string" },
        "kabupaten": { "type": "string" },
        "namaCamat": { "type": "string" },
        "pangkatCamat": { "type": "string" },
        "nipCamat": { "type": "string" },
        "jabatanCamat": { "type": "string" },
        "alamatKantor": { "type": "string" },
        "kodePos": { "type": "string" },
        "emailKantor": { "type": "string" },
        "teleponKantor": { "type": "string" },
        "tempatSurat": { "type": "string" }
      },
      "required": ["namaKecamatan", "kabupaten", "namaCamat", "nipCamat"]
    }
  },
  "firestore": {
    "/asets/{asetId}": {
      "schema": "Aset",
      "description": "Semua data inventaris aset desa yang tersinkronisasi antar-laptop"
    },
    "/verifikasi/{verifikasiId}": {
      "schema": "PermohonanVerifikasi",
      "description": "Pengajuan mutasi dan penghapusan aset"
    },
    "/pengesahan/{pengesahanId}": {
      "schema": "PengesahanLaporan",
      "description": "Pengesahan laporan inventaris tahunan"
    },
    "/desas/{desaId}": {
      "schema": "Desa",
      "description": "Data profil desa"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Data akun pengguna"
    },
    "/system/{configId}": {
      "schema": "KecamatanProfile",
      "description": "Konfigurasi profil kecamatan dan sistem"
    }
  }
}
