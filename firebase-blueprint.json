{
  "entities": {
    "Aset": {
      "title": "Aset",
      "description": "Data Aset Desa SIPADES",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "desaId": { "type": "string" },
        "desaName": { "type": "string" },
        "klasifikasi": { "type": "string" },
        "namaAset": { "type": "string" },
        "kodeAset": { "type": "string" },
        "tahunPerolehan": { "type": "number" },
        "nilaiPerolehan": { "type": "number" },
        "kondisi": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "desaId", "namaAset", "kodeAset"]
    },
    "PermohonanVerifikasi": {
      "title": "PermohonanVerifikasi",
      "description": "Permohonan mutasi atau penghapusan aset desa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "asetId": { "type": "string" },
        "desaId": { "type": "string" },
        "jenis": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "asetId", "desaId", "jenis", "status"]
    },
    "Desa": {
      "title": "Desa",
      "description": "Profil Desa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "KecamatanProfile": {
      "title": "KecamatanProfile",
      "description": "Profil Camat & Kecamatan",
      "type": "object",
      "properties": {
        "namaKecamatan": { "type": "string" },
        "namaCamat": { "type": "string" }
      }
    },
    "SystemAnnouncement": {
      "title": "SystemAnnouncement",
      "description": "Pengumuman dan siaran dari Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "senderName": { "type": "string" },
        "createdAt": { "type": "string" },
        "priority": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "message", "createdAt"]
    }
  },
  "firestore": {
    "/asets/{asetId}": {
      "schema": "Aset",
      "description": "Koleksi inventaris aset seluruh desa se-Kecamatan Sirombu"
    },
    "/verifikasiList/{verifId}": {
      "schema": "PermohonanVerifikasi",
      "description": "Daftar permohonan mutasi dan penghapusan aset desa"
    },
    "/desas/{desaId}": {
      "schema": "Desa",
      "description": "Profil 25 desa se-Kecamatan Sirombu"
    },
    "/system/{docId}": {
      "schema": "KecamatanProfile",
      "description": "Konfigurasi profil kecamatan dan camat"
    },
    "/announcements/{annId}": {
      "schema": "SystemAnnouncement",
      "description": "Pengumuman siaran real-time lintas perangkat dan browser"
    }
  }
}
